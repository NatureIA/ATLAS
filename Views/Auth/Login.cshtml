@model LoginInput
@{ ViewData["Title"]="Entrar"; }
<section class="atlas-login" aria-label="Acesso ao ATLAS">
  <div class="atlas-login-visual">
    <div class="atlas-login-brand" aria-label="ATLAS Financial Intelligence">
      <strong>ATLAS</strong>
      <span>FINANCIAL INTELLIGENCE</span>
    </div>
    <div class="atlas-login-message">
      <h1>Clareza para<br />decidir.<br />Controle para<br />crescer.</h1>
    </div>
    <p class="atlas-login-footer">Uma nova perspectiva sobre as suas finanças.</p>
  </div>
  <div class="atlas-login-panel">
    <div class="atlas-login-content">
      <div class="atlas-login-eyebrow">ACESSO SEGURO</div>
      <h2>Bem-vindo de volta</h2>
      <p class="atlas-login-subtitle">Acesse seu espaço financeiro.</p>
      <form asp-controller="Auth" asp-action="Login" method="post" asp-antiforgery="true" class="atlas-login-form">
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="atlas-login-field">
          <label asp-for="Email">E-mail</label>
          <input asp-for="Email" type="email" autocomplete="username" inputmode="email" required />
          <span asp-validation-for="Email" class="validation"></span>
        </div>
        <div class="atlas-login-field">
          <label asp-for="Password">Senha</label>
          <input asp-for="Password" type="password" autocomplete="current-password" required />
          <span asp-validation-for="Password" class="validation"></span>
        </div>
        <button class="atlas-login-submit" type="submit">Entrar no ATLAS</button>
      </form>
    </div>
  </div>
</section>
