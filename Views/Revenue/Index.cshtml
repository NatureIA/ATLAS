@model RevenueListVm
@{ ViewData["Title"]="Faturamento"; var competenceLabel=new DateTime(Model.Year!.Value,Model.Month!.Value,1).ToString("MMMM yyyy",CultureInfo.GetCultureInfo("pt-BR")); var filtersActive=!string.IsNullOrWhiteSpace(Model.Search)||!string.IsNullOrWhiteSpace(Model.PaymentMethod)||!string.IsNullOrWhiteSpace(Model.Status)||!string.IsNullOrWhiteSpace(Model.Group); }
<section class="expense-due-section" aria-label="Central de recebimentos">
  <div class="expense-due-heading">
    <div class="expense-due-title"><h3>Recebimentos</h3><span class="expense-due-period">@competenceLabel</span></div>
    <div class="expense-due-actions"><a class="expense-due-reset" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Ver todas da competência</a><a class="btn dark" asp-action="Create">+ Nova receita</a></div>
  </div>
  <div class="expense-due-grid revenue-due-grid">
  @foreach(var bucket in Model.Buckets){
    var active=Model.Group==bucket.Key;
    var cardUrl=Url.Action("Index","Revenue",new {year=Model.Year,month=Model.Month,
        search=Model.Search,paymentMethod=Model.PaymentMethod,group=active?null:bucket.Key});
    <a href="@cardUrl" class="expense-due-card @(active?"selected":"")" aria-current="@(active?"true":null)">
      <span class="expense-due-label">@bucket.Label</span>
      <strong class="expense-due-count">@bucket.Count</strong>
      <span class="expense-due-amount">@bucket.Amount.ToString("C")</span>
      <span class="expense-due-hint">@(active?"Filtro ativo":"Ver receitas") <span aria-hidden="true">↗</span></span>
    </a>
  }
  </div>
</section>
<details class="expense-filter-disclosure">
  <summary class="expense-filter-trigger"><span class="expense-filter-trigger-name"><span class="expense-filter-trigger-icon" aria-hidden="true">☷</span><span class="expense-filter-closed-label">Exibir filtros</span><span class="expense-filter-open-label">Ocultar filtros</span></span>@if(filtersActive){<span class="expense-filter-active">Filtros ativos</span>}<span class="expense-filter-chevron" aria-hidden="true">⌄</span></summary>
<form method="get" class="card filter-card"><input name="group" type="hidden" value="@Model.Group" /><div class="filter-grid">
<div class="field"><label>Pesquisar</label><input name="search" value="@Model.Search" placeholder="Item ou referência" /></div>
<div class="field"><label>Situação</label><select name="status"><option value="">Todas</option><option value="received" selected="@(Model.Status=="received")">Recebidas</option><option value="pending" selected="@(Model.Status=="pending")">A receber</option></select></div>
<div class="field"><label>Forma de recebimento</label><select name="paymentMethod"><option value="">Todas</option>
@foreach(var method in new[]{"Pix","Dinheiro","Débito","Crédito","Transferência"}){<option value="@method" selected="@(Model.PaymentMethod==method)">@method</option>}
</select></div>
<div class="field"><label>Ano da competência</label><input name="year" type="number" min="2000" max="2100" value="@Model.Year" required /></div>
<div class="field"><label>Mês da competência</label><select name="month" required>@for(var i=1;i<=12;i++){<option value="@i" selected="@(Model.Month==i)">@CultureInfo.GetCultureInfo("pt-BR").DateTimeFormat.GetMonthName(i)</option>}</select></div>
</div><div class="filter-actions"><button class="btn dark" type="submit">Filtrar</button><a class="btn ghost" asp-action="Index">Mês atual / Limpar</a></div></form>
</details>
<section class="card table-card"><div class="card-title"><div><h3>Receitas registradas — @competenceLabel</h3></div><span class="card-meta">Até 500 registros</span></div>
@if(Model.Rows.Count==0){<div class="empty-inline">Nenhuma receita encontrada para os filtros selecionados.</div>}
else{<div class="table-scroll"><table><thead><tr><th>Item / origem</th><th>Competência</th><th>Previsão</th><th>Recebido em</th><th>Forma</th><th>Referência</th><th>Tipo</th><th>Situação</th><th class="align-right">Valor</th><th>Ações</th></tr></thead><tbody>
@foreach(var row in Model.Rows){<tr><td class="strong-cell">@row.RevenueItemName</td><td>@row.Date.ToString("dd/MM/yyyy")</td><td>@(row.ExpectedReceiptDate?.ToString("dd/MM/yyyy")??"—")</td><td>@(row.ReceivedDate?.ToString("dd/MM/yyyy")??"—")</td><td>@row.PaymentMethod</td><td>@(row.ReferenceName??"—")</td>
<td>@if(row.RecurringSeriesId!=null){<span class="pill lavender">Recorrente</span>}else{<span class="pill neutral">Avulsa</span>}</td>
<td><span class="pill @(row.Received?"paid":"pending")">@(row.Received?"Recebido":row.ExpectedReceiptDate<DateTime.Today?"Em atraso":"A receber")</span></td>
<td class="align-right amount-positive">@row.Amount.ToString("C")</td><td><div class="row-actions">
@if(!row.Received){<form asp-action="Receive" asp-route-id="@row.Id" method="post"><button class="link-action success-text" type="submit">Confirmar recebimento</button></form>}
<a asp-action="Edit" asp-route-id="@row.Id" class="link-action">Editar</a>
@if(row.RecurringSeriesId is Guid sid){<form asp-action="End" asp-route-id="@sid" method="post" data-confirm="Encerrar recorrência e remover receitas futuras?"><button class="link-action danger">Encerrar</button></form>}
else{<form asp-action="Delete" asp-route-id="@row.Id" method="post" data-confirm="Excluir esta receita?"><button class="link-action danger">Excluir</button></form>}
</div></td></tr>}
</tbody></table></div>}
</section>