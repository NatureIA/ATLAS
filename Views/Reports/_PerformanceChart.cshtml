@model List<MonthlyPoint>
<div class="report-performance report-area" id="reportPerformance">
  <fieldset class="report-performance-flags" aria-label="Indicadores exibidos no gráfico">
    <legend>Exibir no gráfico</legend>
    <label class="report-flag report-flag-revenue">
      <input type="checkbox" value="revenue" checked />
      <span class="report-flag-mark" aria-hidden="true"></span>Faturamento
    </label>
    <label class="report-flag report-flag-expense">
      <input type="checkbox" value="expense" checked />
      <span class="report-flag-mark" aria-hidden="true"></span>Despesas
    </label>
    <label class="report-flag report-flag-result">
      <input type="checkbox" value="result" checked />
      <span class="report-flag-mark" aria-hidden="true"></span>Resultado
    </label>
  </fieldset>
  <p class="report-performance-note">Evolução financeira mensal. Resultado = faturamento − despesas; valores negativos ficam abaixo de zero.</p>
  <div class="report-area-data" hidden>
    @foreach(var point in Model){
      <span data-month="@point.Label"
            data-revenue="@point.Income.ToString(CultureInfo.InvariantCulture)"
            data-expense="@point.Expense.ToString(CultureInfo.InvariantCulture)"
            data-result="@point.Result.ToString(CultureInfo.InvariantCulture)"></span>
    }
  </div>
  <div class="report-area-chart" id="reportAreaChart">
    <svg id="reportAreaSvg" class="report-area-svg" viewBox="0 0 960 320" aria-label="Evolução mensal de faturamento, despesas e resultado de janeiro a dezembro" role="img">
      <text x="480" y="158" fill="#8f9d93" text-anchor="middle">Carregando gráfico financeiro…</text>
    </svg>
    <div class="report-area-tooltip" id="reportAreaTooltip" aria-hidden="true"></div>
  </div>
  <p class="report-performance-empty hidden" role="status">Marque ao menos um indicador para visualizar o gráfico.</p>
</div>
