@model DashboardVm
@{
  ViewData["Title"]="Visão geral";
  var selected=new DateTime(Model.Year,Model.Month==0?1:Model.Month,1);
  var previous=selected.AddMonths(-1);
  var following=selected.AddMonths(1);
  var expensesMonth=Model.Month==0?Model.Today.Month:Model.Month;
}
<div class="atlas-overview" id="atlasOverview">
  <div class="atlas-overview-head">
    <div class="atlas-period-controls" aria-label="Competência">
      @if(!Model.FullYear){
        <a asp-action="Index" asp-route-year="@previous.Year" asp-route-month="@previous.Month" aria-label="Competência anterior">‹</a>
      }
      <strong>@Model.PeriodLabel</strong>
      @if(!Model.FullYear){
        <a asp-action="Index" asp-route-year="@following.Year" asp-route-month="@following.Month" aria-label="Próxima competência">›</a>
      }
    </div>
    <div class="atlas-overview-shortcuts">
      <a asp-action="Index" asp-route-year="@Model.Today.Year" asp-route-month="@Model.Today.Month" class="atlas-small-link" aria-current="@(!Model.FullYear&&Model.Month==Model.Today.Month&&Model.Year==Model.Today.Year?"page":null)">Mês atual</a>
      <a asp-action="Index" asp-route-year="@Model.Year" asp-route-month="0" class="atlas-small-link" aria-current="@(Model.FullYear?"page":null)">Ano inteiro</a>
    </div>
  </div>

  <section aria-labelledby="atlasOverviewSummary" class="atlas-overview-section">
    <h2 id="atlasOverviewSummary" class="atlas-overview-section-title">Resumo financeiro</h2>
    <div class="atlas-overview-metrics">
      <a asp-controller="Revenue" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="atlas-overview-metric">
        <span>Faturamento</span><strong>@Model.Revenue.ToString("C")</strong><small>Receitas da competência</small>
      </a>
      <a asp-controller="Revenue" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@Model.Month" asp-route-group="received" class="atlas-overview-metric">
        <span>Recebido</span><strong>@Model.ReceivedRevenue.ToString("C")</strong><small>Receitas confirmadas</small>
      </a>
      <a asp-controller="Expenses" asp-action="Index" asp-route-year="@Model.Year" asp-route-month="@expensesMonth" class="atlas-overview-metric">
        <span>Despesas</span><strong>@Model.Expenses.ToString("C")</strong><small>Pagas e pendentes da competência</small>
      </a>
      <div class="atlas-overview-metric atlas-overview-metric-emphasis">
        <span>Resultado</span><strong>@Model.Profit.ToString("C")</strong><small>Faturamento − despesas</small>
      </div>
    </div>
    @if(Model.FullYear){
      <p class="atlas-overview-footnote">O resultado anual considera todas as receitas e despesas de @Model.Year. Para consultar despesas específicas por competência, utilize os filtros no módulo Despesas.</p>
    }
  </section>

  <section class="atlas-overview-section" aria-labelledby="atlasAttentionTitle">
    <div class="atlas-overview-section-heading">
      <h2 id="atlasAttentionTitle" class="atlas-overview-section-title">Atenção financeira</h2>
      <span>Posição atual · @Model.Today.ToString("dd/MM/yyyy")</span>
    </div>
    <div class="atlas-attention-grid">
      @foreach(var alert in Model.Alerts){
        <a href="@alert.Url" class="atlas-attention-item">
          <span class="atlas-attention-label">@alert.Label</span>
          <strong>@alert.Amount.ToString("C")</strong>
          <small>@alert.Count lançamento(s) · Abrir módulo ↗</small>
        </a>
      }
    </div>
    <p class="atlas-overview-footnote">Atenção considera vencimentos e recebimentos previstos em todas as competências. Os módulos de destino possuem filtros próprios.</p>
  </section>

  <section class="atlas-insight-simple" aria-labelledby="atlasInsightTitle">
    <div><span class="atlas-insight-mark" aria-hidden="true">✦</span><strong id="atlasInsightTitle">ATLAS Insight</strong></div>
    <p>@Model.Insight</p>
  </section>

  <section class="atlas-overview-section atlas-month-forecast" aria-labelledby="atlasCashflowTitle" id="atlasMonthForecast">
    <div class="atlas-overview-section-heading">
      <h2 id="atlasCashflowTitle" class="atlas-overview-section-title">Projeção financeira mensal</h2>
      <div class="atlas-horizon" role="group" aria-label="Período da projeção">
        <button type="button" data-forecast-months="3" aria-pressed="false">3 meses</button>
        <button type="button" data-forecast-months="6" aria-pressed="true">6 meses</button>
        <button type="button" data-forecast-months="12" aria-pressed="false">12 meses</button>
      </div>
    </div>
    <div class="atlas-cashflow-grid">
      <div><small>Entradas previstas</small><strong id="atlasCashIn">@Model.MonthlyForecast.Take(6).Sum(x=>x.Incoming).ToString("C")</strong></div>
      <div><small>Saídas previstas</small><strong id="atlasCashOut">@Model.MonthlyForecast.Take(6).Sum(x=>x.Outgoing).ToString("C")</strong></div>
      <div><small>Resultado previsto</small><strong id="atlasCashNet">@Model.MonthlyForecast.Take(6).Sum(x=>x.Result).ToString("C")</strong></div>
    </div>
    <div class="atlas-month-forecast-legend"><span><i class="forecast-income-swatch"></i> Entradas</span><span><i class="forecast-expense-swatch"></i> Saídas</span></div>
    <div class="atlas-month-forecast-chart" role="group" aria-label="Entradas e saídas mensais previstas">
      @foreach(var point in Model.MonthlyForecast){
        <button type="button" class="atlas-month-forecast-column" data-forecast-index="@point.Index" data-forecast-in="@point.Incoming.ToString(CultureInfo.InvariantCulture)" data-forecast-out="@point.Outgoing.ToString(CultureInfo.InvariantCulture)" aria-expanded="false" aria-controls="forecastDetails-@point.Index" hidden="@(point.Index>=6)">
          <span class="atlas-month-forecast-bars" aria-hidden="true"><span class="atlas-month-forecast-bar forecast-income-bar"></span><span class="atlas-month-forecast-bar forecast-expense-bar"></span></span>
          <span class="atlas-month-forecast-month">@point.Label</span>
          <span class="atlas-month-forecast-result">@point.Result.ToString("C")</span>
        </button>
      }
    </div>
    <div class="atlas-month-forecast-details" id="atlasForecastDetails" aria-live="polite">
      <p class="atlas-overview-footnote">Selecione um mês do gráfico para consultar os lançamentos previstos.</p>
      @foreach(var point in Model.MonthlyForecast){
        <div class="atlas-month-forecast-detail" id="forecastDetails-@point.Index" data-forecast-detail="@point.Index" hidden>
          <div class="atlas-month-forecast-detail-title"><strong>@point.Label — Resultado: @point.Result.ToString("C")</strong><span>@point.Entries.Count lançamento(s)</span></div>
          @if(point.Entries.Count==0){
            <p class="atlas-overview-footnote">Nenhum recebimento ou vencimento previsto para este mês.</p>
          } else {
            <div class="atlas-month-forecast-entries">
              @foreach(var entry in point.Entries){
                <a asp-controller="@(entry.IsRevenue?"Revenue":"Expenses")" asp-action="Edit" asp-route-id="@entry.Id">
                  <span><strong>@entry.Name</strong><small>@entry.ExpectedDate.ToString("dd/MM/yyyy") · @(entry.IsRevenue?"A receber":"A pagar")</small></span>
                  <b class="@(entry.IsRevenue?"amount-positive":"amount-negative")">@(entry.IsRevenue?"+":"−")@entry.Amount.ToString("C")</b>
                </a>
              }
            </div>
          }
        </div>
      }
    </div>
    <p class="atlas-overview-footnote">Projeção por data prevista de recebimento e vencimento, incluindo recorrências. O mês atual considera somente hoje em diante; pendências atrasadas aparecem em Atenção financeira. Não representa saldo bancário nem inclui lançamentos sem data informada.</p>
  </section>

  <details class="atlas-overview-details" open>
    <summary><span>Análises e histórico</span><span class="atlas-overview-detail-state">Ocultar / Exibir</span></summary>
    <div class="atlas-overview-detail-body">
      <div class="atlas-overview-analysis-grid">
        <section class="card">
          <div class="card-title"><h3>Evolução financeira</h3><span class="card-meta">@(Model.FullYear?"12 meses":"Últimos 6 meses")</span></div>
          <partial name="_Chart" model="Model.History" />
        </section>
        <section class="card">
          <div class="card-title"><h3>Receitas por origem</h3></div>
          <partial name="_Ranking" model="Model.Sources" />
        </section>
      </div>
      <div class="atlas-overview-analysis-grid">
        <section class="card">
          <div class="card-title"><h3>Movimentações recentes</h3></div>
          @if(Model.Activity.Count==0){<div class="empty-inline">Nenhuma movimentação nesta competência.</div>}
          else{
            <div class="recent-list">
              @foreach(var activity in Model.Activity){
                <a asp-controller="@(activity.IsRevenue?"Revenue":"Expenses")" asp-action="Edit" asp-route-id="@activity.Id" class="recent-row">
                  <span class="recent-symbol">@(activity.IsRevenue?"↗":"↙")</span>
                  <span><strong>@activity.Name</strong><small>@activity.Date.ToString("dd/MM/yyyy") · @activity.Status</small></span>
                  <b class="@(activity.IsRevenue?"amount-positive":"amount-negative")">@(activity.IsRevenue?"+":"−")@activity.Amount.ToString("C")</b>
                </a>
              }
            </div>
          }
        </section>
        <section class="card">
          <div class="card-title"><h3>Despesas por categoria</h3></div>
          <partial name="_Ranking" model="Model.Categories" />
        </section>
      </div>
    </div>
  </details>
  <details class="atlas-overview-details">
    <summary><span>Metas e indicadores adicionais</span><span class="atlas-overview-detail-state">Ocultar / Exibir</span></summary>
    <div class="atlas-overview-extra">
      <div><small>Margem por competência</small><strong>@Model.Margin.ToString("N1")%</strong></div>
      <div><small>Ticket médio</small><strong>@Model.Ticket.ToString("C")</strong></div>
      <div><small>Receitas a receber na competência</small><strong>@Model.PendingRevenue.ToString("C")</strong></div>
      <div><small>Despesas pagas na competência</small><strong>@Model.ExpensesPaidInPeriod.ToString("C")</strong></div>
      @if(!Model.FullYear){
        <div><small>Meta da competência</small><strong>@Model.Target.ToString("C")</strong></div>
        <div><small>Falta para a meta</small><strong>@Model.Remaining.ToString("C")</strong></div>
        <div><small>Projeção de faturamento</small><strong>@Model.ProjectedRevenue.ToString("C")</strong></div>
        <div><small>Necessário por dia</small><strong>@Model.DailyNeeded.ToString("C")</strong></div>
      }
    </div>
  </details>
</div>