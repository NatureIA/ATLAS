@model RevenueListVm
@{ ViewData["Title"]="Faturamento"; }
<div class="section-heading"><div><div class="eyebrow">ENTRADAS FINANCEIRAS</div><h2>Faturamento</h2><p class="muted">Registre, consulte e acompanhe suas receitas.</p></div>
<a class="btn dark" asp-action="Create">+ Nova receita</a></div>
<form method="get" class="card filter-card"><div class="filter-grid">
<div class="field"><label>Pesquisar</label><input name="search" value="@Model.Search" placeholder="Item ou referência" /></div>
<div class="field"><label>Recebimento</label><select name="paymentMethod"><option value="">Todas</option>
@foreach(var method in new[]{"Pix","Dinheiro","Débito","Crédito","Transferência"}){<option value="@method" selected="@(Model.PaymentMethod==method)">@method</option>}
</select></div>
<div class="field"><label>Ano</label><input name="year" type="number" min="2000" max="2100" value="@Model.Year" placeholder="Todos" /></div>
<div class="field"><label>Mês</label><select name="month"><option value="">Todos</option>@for(var i=1;i<=12;i++){<option value="@i" selected="@(Model.Month==i)">@CultureInfo.GetCultureInfo("pt-BR").DateTimeFormat.GetMonthName(i)</option>}</select></div>
</div><div class="filter-actions"><button class="btn dark" type="submit">Filtrar</button><a class="btn ghost" asp-action="Index">Limpar</a></div></form>
<section class="card table-card"><div class="card-title"><div><div class="eyebrow">MOVIMENTAÇÕES</div><h3>Receitas registradas</h3></div><span class="card-meta">Até 500 registros</span></div>
@if(Model.Rows.Count==0){<div class="empty-inline">Nenhuma receita encontrada. Use “Nova receita” para começar.</div>}
else{<div class="table-scroll"><table><thead><tr><th>Item / origem</th><th>Data</th><th>Forma</th><th>Referência</th><th>Tipo</th><th class="align-right">Valor</th><th>Ações</th></tr></thead><tbody>
@foreach(var row in Model.Rows){<tr><td class="strong-cell">@row.RevenueItemName</td><td>@row.Date.ToString("dd/MM/yyyy")</td><td>@row.PaymentMethod</td><td>@(row.ReferenceName??"—")</td>
<td>@if(row.RecurringSeriesId!=null){<span class="pill lavender">Recorrente</span>}else{<span class="pill neutral">Avulsa</span>}</td>
<td class="align-right amount-positive">@row.Amount.ToString("C")</td><td><div class="row-actions"><a asp-action="Edit" asp-route-id="@row.Id" class="link-action">Editar</a>
@if(row.RecurringSeriesId is Guid sid){<form asp-action="End" asp-route-id="@sid" method="post" data-confirm="Encerrar recorrência e remover receitas futuras?" ><button class="link-action danger">Encerrar</button></form>}
else{<form asp-action="Delete" asp-route-id="@row.Id" method="post" data-confirm="Excluir esta receita?" ><button class="link-action danger">Excluir</button></form>}
</div></td></tr>}
</tbody></table></div>}
</section>